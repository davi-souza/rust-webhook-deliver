# Backend Configuration
PORT=8000
RUST_LOG=info,rust_webhook=debug

# Frontend Configuration
FRONTEND_PORT=5173

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rust_webhook
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/rust_webhook

# Redis Configuration
REDIS_PORT=6379
DELIVERY_CONCURRENCY=10
DELIVERY_HTTP_TIMEOUT_SECS=30
DELIVERY_BACKOFF_BASE_SECS=5
DELIVERY_BACKOFF_MAX_SECS=300
DELIVERY_BACKOFF_JITTER_PERCENT=20
DELIVERY_POLL_INTERVAL_MS=1000
DELIVERY_RECONCILE_INTERVAL_SECS=60
DELIVERY_BATCH_SIZE=100
REDIS_URL=redis://redis:6379

# pgAdmin Configuration
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
